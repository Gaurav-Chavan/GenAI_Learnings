# Copy to .env and fill in real values:  cp .env.example .env
# Never commit .env.

# OpenAI
OPENAI_API_KEY=sk-...

# Neo4j Aura Free (from the credentials file Aura gives you)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
# Aura Free databases are usually named "neo4j"; the tutorial instance used its instance id
NEO4J_DATABASE=neo4j

# Model overrides (defaults shown)
# CHAT_MODEL=gpt-4o-mini
# CYPHER_MODEL=gpt-4o
# JUDGE_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# Optional: require a password in the Streamlit app (recommended on a public URL)
# APP_PASSWORD=choose-something

# Optional: LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=orggraph-rag
