# Copy to .env and fill in. Never commit .env.

# While true, tools return deterministic fake data (no API keys needed).
USE_STUBS=true

TAVILY_API_KEY=

# Orchestrator / writer model, "provider:model" (LangChain init_chat_model format)
ORCHESTRATOR_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Nebius Token Factory (OpenAI-compatible) for the Analyst's extraction calls.
# Model IDs need the publisher prefix; confirm the ID in your Nebius console.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
ANALYST_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=competitor-analysis-agent

# Guardrails
MAX_RETRIES=2
MAX_TAVILY_CALLS=40
MAX_REVISIONS=2
TOP_N_COMPETITORS=3
BRIEFINGS_DIR=briefings
CHECKPOINT_DB=checkpoints.sqlite
