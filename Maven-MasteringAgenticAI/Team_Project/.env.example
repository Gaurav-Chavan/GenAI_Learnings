# Copy to .env (git-ignored) or put the same NAME=value lines in API_Keys.txt. Never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# optional: Langfuse tracing (uv sync --group tracing). Without these, nothing is traced and nothing breaks.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# optional, not used yet
LANGSMITH_API_KEY=
