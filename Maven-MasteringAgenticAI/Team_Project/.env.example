# Copy this file to .env (it is git-ignored) and fill in YOUR OWN values. Never commit a real key, and never share yours.
# README.md, step 3, explains where to get each one.

# Model keys, used to run the agents and the evaluation. Your own keys; every run costs money.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# YOUR OWN Neo4j Aura instance (the free tier is enough). Do not share one instance between teammates:
# loading the graph deletes everything in the target database.
# Aura gives you a file called Neo4j-<id>-Created-<date>.txt; copy its NEO4J_ lines here, or keep that file in this folder (it is git-ignored too).
# The URI looks like neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# optional: Langfuse tracing (uv sync --group tracing). Without these, nothing is traced and nothing breaks.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# optional, not used yet
LANGSMITH_API_KEY=
