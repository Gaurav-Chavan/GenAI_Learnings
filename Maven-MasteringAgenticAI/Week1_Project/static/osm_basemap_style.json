{
  "version": 8,
  "name": "NCR RidePulse - OpenStreetMap standard tiles (muted)",
  "sources": {
    "osm": {
      "type": "raster",
      "tiles": ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
      "tileSize": 256,
      "maxzoom": 19,
      "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">OpenStreetMap</a> contributors"
    }
  },
  "layers": [
    {
      "id": "osm-standard",
      "type": "raster",
      "source": "osm",
      "paint": {
        "raster-saturation": -0.75,
        "raster-contrast": -0.1,
        "raster-opacity": 0.95
      }
    }
  ]
}
